# Copy to .env for local development — NEVER commit .env to Git

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/nexgen_db?sslmode=require"
ANTHROPIC_API_KEY="sk-ant-..."

# ── Auth (REQUIRED in production) ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
# Default admin on first boot: admin@corverxis.com / LabAdmin@2024!
# Change the password immediately after first login.

# ── Optional: enables pgvector semantic search in RAG, powered by NexGen Pro ─
# Until both are set, RAG falls back to PostgreSQL full-text search automatically.
NEXGEN_PRO_API_KEY="nxg-..."
NEXGEN_INFERENCE_URL="https://your-nexgen-pro-endpoint.runpod.net"

# ── Optional: Langfuse observability ────────────────────────────────────────
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"   # or self-hosted URL

# ── Optional: MLflow experiment tracking ────────────────────────────────────
MLFLOW_TRACKING_URI="http://localhost:5000"  # or your MLflow server URL

# ── Optional: Google Vertex AI ──────────────────────────────────────────────
GCP_PROJECT="your-gcp-project-id"
GCP_REGION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Get from Stripe → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Your deployed lab URL (for Stripe redirect URLs)
APP_URL="https://nexgen-frontier-lab.onrender.com"

# ── Multi-language code execution ────────────────────────────────────────────
# Python 3 and Node.js run out of the box on Render's standard Node image.
# TypeScript requires: npm install -g ts-node typescript  (add to build command)
# Swift requires a Swift toolchain installed on the container — not present by
#   default on Render's Node runtime. Requires a custom Docker image with Swift
#   installed, or a separate execution service. Missing toolchain fails
#   gracefully with a clear error rather than crashing the server.
# Kotlin requires: apt-get install kotlin  (or a JDK + kotlinc), same caveat as
#   Swift — needs a custom Docker image on Render's default Node runtime.
