generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Core: Training records ────────────────────────────────────────────────────
model Record {
  id            String   @id @default(cuid())
  domain        String
  systemPrompt  String   @map("system_prompt") @db.Text
  messages      Json
  reviewStatus  String   @default("needs_review") @map("review_status")
  createdById   String?  @map("created_by_id")
  reviewedById  String?  @map("reviewed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("records")
}

// ── Core: LoRA/PEFT training jobs ────────────────────────────────────────────
model Job {
  id          String   @id @default(cuid())
  tier        String
  baseModel   String   @map("base_model")
  recordCount Int      @default(0) @map("record_count")
  epochs      Int      @default(3)
  seqLen      Int      @default(4096) @map("seq_len")
  loraR       Int      @default(32) @map("lora_r")
  lr          Float    @default(0.0001)
  status      String   @default("queued")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("jobs")
}

// ── Pipelines: LangChain / LangGraph / RAG / Custom ──────────────────────────
model Pipeline {
  id        String        @id @default(cuid())
  name      String
  type      String        // langchain | langgraph | rag | custom
  config    Json          @default("{}")
  status    String        @default("inactive")
  runs      PipelineRun[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("pipelines")
}

model PipelineRun {
  id         String   @id @default(cuid())
  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  input      Json
  output     Json?
  status     String   @default("pending")
  latencyMs  Int?     @map("latency_ms")
  tokens     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("pipeline_runs")
}

// ── MLflow-compatible experiment tracking ────────────────────────────────────
model Experiment {
  id        String          @id @default(cuid())
  name      String
  tags      Json            @default("{}")
  runs      ExperimentRun[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("experiments")
}

model ExperimentRun {
  id           String     @id @default(cuid())
  experimentId String     @map("experiment_id")
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  name         String?
  params       Json       @default("{}")
  metrics      Json       @default("{}")
  artifacts    Json       @default("[]")
  status       String     @default("running")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("experiment_runs")
}

// ── RAG: Vector documents (pgvector / FAISS) ─────────────────────────────────
// Note: the `embedding` column (vector(1536)) is added via raw SQL on startup
// because Prisma's Unsupported type is read-only. All embedding operations
// use $queryRaw / $executeRaw.
model VectorDocument {
  id        String   @id @default(cuid())
  content   String   @db.Text
  metadata  Json     @default("{}")
  source    String   @default("manual")
  chunkIdx  Int      @default(0) @map("chunk_idx")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vector_documents")
}

// ── Tiered Memory Architecture (LLM Limitation #3 fix) ───────────────────────
// Working memory = the live context window, handled in server.js at request time.
// Episodic memory = this table — a per-user, per-API-key long-term store.
model Memory {
  id             String   @id @default(cuid())
  ownerKey       String   @map("owner_key")        // the nxg-... API key this memory belongs to (per-user isolation)
  type           String                             // "user_fact" | "model_suggestion"
  content        String   @db.Text
  sourceExcerpt  String?  @map("source_excerpt") @db.Text   // the conversation turn this came from
  conversationId String?  @map("conversation_id")
  visible        Boolean  @default(true)             // consent/transparency — user can hide without deleting
  confidence     Float?   @default(1.0)               // lower for model_suggestion, 1.0 for user-confirmed facts
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerKey])
  @@map("memories")
}

// ── Working-memory conversation summaries (context window pruning) ───────────
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  ownerKey       String   @map("owner_key")
  summary        String   @db.Text     // rolling summary of pruned older turns
  turnsCompressed Int     @default(0) @map("turns_compressed")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("conversation_summaries")
}

// ── Grounding / Verification log (LLM Limitation #4 fix) ─────────────────────
model VerificationLog {
  id          String   @id @default(cuid())
  ownerKey    String?  @map("owner_key")
  claim       String   @db.Text
  claimType   String   @map("claim_type")     // "time_sensitive" | "user_asserted" | "contested"
  sources     Json     @default("[]")          // list of {url, snippet, agrees:bool}
  corroborated Boolean @default(false)
  conflictFlagged Boolean @default(false) @map("conflict_flagged")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("verification_logs")
}

// ── Deterministic Mode (LLM Limitation #5 fix) ────────────────────────────────
// Caches responses for factual/procedural queries so the same question
// returns the exact same answer every time, instead of drifting run to run.
model ResponseCache {
  id         String    @id @default(cuid())
  cacheKey   String    @unique @map("cache_key")   // hash(model + system + normalized query)
  model      String
  query      String    @db.Text
  response   String    @db.Text
  hitCount   Int       @default(0) @map("hit_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastHitAt  DateTime? @map("last_hit_at")

  @@map("response_cache")
}

// ── Versioned Reasoning Logs (LLM Limitation #5 fix) ──────────────────────────
// One row per response — what mode it ran in, what was retrieved, what tools
// fired, and whether it came from cache — so a "why did this answer change"
// question can be diagnosed instead of just observed.
model ReasoningLog {
  id              String   @id @default(cuid())
  requestId       String   @map("request_id")
  logVersion      Int      @default(1) @map("log_version")   // schema version of this log entry itself
  mode            String                                       // "deterministic" | "creative"
  temperature     Float
  wasCached       Boolean  @default(false) @map("was_cached")
  memoryFactsUsed Int      @default(0) @map("memory_facts_used")
  memorySuggestionsUsed Int @default(0) @map("memory_suggestions_used")
  toolsCalled     Json     @default("[]") @map("tools_called")
  groundingFlagged Boolean @default(false) @map("grounding_flagged")
  confidence      Float?
  ownerKey        String?  @map("owner_key")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@index([ownerKey])
  @@map("reasoning_logs")
}

// ── Observability: Langfuse-compatible traces ─────────────────────────────────
model Trace {
  id        String   @id @default(cuid())
  name      String
  input     Json
  output    Json?
  model     String?
  latencyMs Int?     @map("latency_ms")
  tokens    Int      @default(0)
  cost      Float    @default(0)
  score     Float?
  tags      Json     @default("[]")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("traces")
}

// ── MCP: Model Context Protocol server registry ───────────────────────────────
model McpServer {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("sse")    // sse | http | stdio
  tools     Json     @default("[]")
  status    String   @default("inactive")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mcp_servers")
}

// ── Scripts: Python / Shell script library ───────────────────────────────────
model Script {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  language    String   @default("python")
  code        String   @db.Text
  tags        Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("scripts")
}

// ── Auth: Users & Sessions ────────────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("intern")   // admin | engineer | intern
  status      String    @default("active")   // active | suspended
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model ApiEndpoint {
  id             String       @id @default(cuid())
  name           String
  method         String       @default("POST")
  path           String
  description    String?      @db.Text
  requestSchema  Json         @default("{}") @map("request_schema")
  responseSchema Json         @default("{}") @map("response_schema")
  headers        Json         @default("{}")
  auth           String       @default("api_key")
  status         String       @default("draft")
  version        String       @default("v1")
  requests       ApiRequest[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("api_endpoints")
}

// ── API Dev: API keys ─────────────────────────────────────────────────────────
model ApiKey {
  id           String    @id @default(cuid())
  name         String
  key          String    @unique
  prefix       String
  permissions  Json      @default("[]")
  status       String    @default("active")
  requestCount Int       @default(0) @map("request_count")
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

// ── API Dev: Pipeline definitions ─────────────────────────────────────────────
model ApiPipeline {
  id           String           @id @default(cuid())
  name         String
  description  String?          @db.Text
  steps        Json             @default("[]")
  inputSchema  Json             @default("{}") @map("input_schema")
  outputSchema Json             @default("{}") @map("output_schema")
  status       String           @default("draft")
  runs         ApiPipelineRun[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("api_pipelines")
}

model ApiPipelineRun {
  id         String      @id @default(cuid())
  pipelineId String      @map("pipeline_id")
  pipeline   ApiPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  input      Json
  output     Json?
  steps      Json        @default("[]")
  status     String      @default("pending")
  latencyMs  Int?        @map("latency_ms")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("api_pipeline_runs")
}

// ── API Dev: Request history (tester + live traffic) ─────────────────────────
model ApiRequest {
  id          String       @id @default(cuid())
  endpointId  String?      @map("endpoint_id")
  endpoint    ApiEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  method      String
  path        String
  headers     Json         @default("{}")
  body        Json?
  response    Json?
  statusCode  Int?         @map("status_code")
  latencyMs   Int?         @map("latency_ms")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("api_requests")
}

// ── Billing: Customers & Subscriptions ───────────────────────────────────────
model Customer {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  stripeCustomerId    String?         @unique @map("stripe_customer_id")
  plan                String          @default("free")
  creditBalance       Float           @default(0) @map("credit_balance")
  autoReload          Boolean         @default(false) @map("auto_reload")
  autoReloadAmount    Float           @default(50) @map("auto_reload_amount")
  autoReloadThreshold Float           @default(5) @map("auto_reload_threshold")
  memoryEnabled       Boolean         @default(true) @map("memory_enabled")  // consent layer — off = no memory writes
  createdAt           DateTime        @default(now()) @map("created_at")
  subscriptions       Subscription[]
  creditPurchases     CreditPurchase[]
  @@map("customers")
}

model Subscription {
  id               String    @id @default(cuid())
  customerId       String    @map("customer_id")
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan             String
  billingPeriod    String    @default("monthly") @map("billing_period")
  status           String    @default("active")
  stripeSubId      String?   @unique @map("stripe_sub_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean  @default(false) @map("cancel_at_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  @@map("subscriptions")
}

model CreditPurchase {
  id              String   @id @default(cuid())
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Float
  discountRate    Float    @default(0) @map("discount_rate")
  creditsAdded    Float    @map("credits_added")
  autoReload      Boolean  @default(false) @map("auto_reload")
  stripePaymentId String?  @map("stripe_payment_id")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  @@map("credit_purchases")
}

// ── Activity Log — tracks every meaningful action per user ───────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")
  action    String              // e.g. "record.created", "record.approved", "pipeline.run", "key.created"
  resource  String?             // e.g. record id, pipeline id
  details   Json?               // extra context (domain, model used, etc.)
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
