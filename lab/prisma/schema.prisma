generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Core: Training records ────────────────────────────────────────────────────
model Record {
  id            String   @id @default(cuid())
  domain        String
  systemPrompt  String   @map("system_prompt") @db.Text
  messages      Json
  reviewStatus  String   @default("needs_review") @map("review_status")
  createdById   String?  @map("created_by_id")
  reviewedById  String?  @map("reviewed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("records")
}

// ── Core: LoRA/PEFT training jobs ────────────────────────────────────────────
model Job {
  id          String   @id @default(cuid())
  tier        String
  baseModel   String   @map("base_model")
  recordCount Int      @default(0) @map("record_count")
  epochs      Int      @default(3)
  seqLen      Int      @default(4096) @map("seq_len")
  loraR       Int      @default(32) @map("lora_r")
  lr          Float    @default(0.0001)
  status      String   @default("queued")
  createdAt   DateTime @default(now()) @map("created_at")

  // ── Automatic dataset export — a stable, long-lived, token-authenticated
  // URL a training environment (e.g. a RunPod bootstrap script) can curl
  // directly, with zero manual export step on the Lab side. The JSONL
  // snapshot is frozen at queue time — approving more records afterward
  // does not silently change what an already-queued job will train on.
  datasetToken           String?   @unique @map("dataset_token")
  datasetStorageKey       String?   @map("dataset_storage_key")
  datasetPersistent       Boolean   @default(false) @map("dataset_persistent")
  datasetTokenExpiresAt   DateTime? @map("dataset_token_expires_at")

  @@map("jobs")
}

// ── Pipelines: LangChain / LangGraph / RAG / Custom ──────────────────────────
model Pipeline {
  id        String        @id @default(cuid())
  name      String
  type      String        // langchain | langgraph | rag | custom
  config    Json          @default("{}")
  status    String        @default("inactive")
  runs      PipelineRun[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("pipelines")
}

model PipelineRun {
  id         String   @id @default(cuid())
  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  input      Json
  output     Json?
  status     String   @default("pending")
  latencyMs  Int?     @map("latency_ms")
  tokens     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("pipeline_runs")
}

// ── MLflow-compatible experiment tracking ────────────────────────────────────
model Experiment {
  id        String          @id @default(cuid())
  name      String
  tags      Json            @default("{}")
  runs      ExperimentRun[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("experiments")
}

model ExperimentRun {
  id           String     @id @default(cuid())
  experimentId String     @map("experiment_id")
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  name         String?
  params       Json       @default("{}")
  metrics      Json       @default("{}")
  artifacts    Json       @default("[]")
  status       String     @default("running")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("experiment_runs")
}

// ── RAG: Vector documents (pgvector / FAISS) ─────────────────────────────────
// Note: the `embedding` column (vector(1536)) is added via raw SQL on startup
// because Prisma's Unsupported type is read-only. All embedding operations
// use $queryRaw / $executeRaw.
model VectorDocument {
  id        String   @id @default(cuid())
  content   String   @db.Text
  metadata  Json     @default("{}")
  source    String   @default("manual")
  chunkIdx  Int      @default(0) @map("chunk_idx")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vector_documents")
}

// ── Tiered Memory Architecture (LLM Limitation #3 fix) ───────────────────────
// Working memory = the live context window, handled in server.js at request time.
// Episodic memory = this table — a per-user, per-API-key long-term store.
model Memory {
  id             String   @id @default(cuid())
  ownerKey       String   @map("owner_key")        // the nxg-... API key this memory belongs to (per-user isolation)
  type           String                             // "user_fact" | "model_suggestion"
  content        String   @db.Text
  sourceExcerpt  String?  @map("source_excerpt") @db.Text   // the conversation turn this came from
  conversationId String?  @map("conversation_id")
  visible        Boolean  @default(true)             // consent/transparency — user can hide without deleting
  confidence     Float?   @default(1.0)               // lower for model_suggestion, 1.0 for user-confirmed facts
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerKey])
  @@map("memories")
}

// ── Working-memory conversation summaries (context window pruning) ───────────
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  ownerKey       String   @map("owner_key")
  summary        String   @db.Text     // rolling summary of pruned older turns
  turnsCompressed Int     @default(0) @map("turns_compressed")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("conversation_summaries")
}

// ── Grounding / Verification log (LLM Limitation #4 fix) ─────────────────────
model VerificationLog {
  id          String   @id @default(cuid())
  ownerKey    String?  @map("owner_key")
  claim       String   @db.Text
  claimType   String   @map("claim_type")     // "time_sensitive" | "user_asserted" | "contested"
  sources     Json     @default("[]")          // list of {url, snippet, agrees:bool}
  corroborated Boolean @default(false)
  conflictFlagged Boolean @default(false) @map("conflict_flagged")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("verification_logs")
}

// ── Deterministic Mode (LLM Limitation #5 fix) ────────────────────────────────
// Caches responses for factual/procedural queries so the same question
// returns the exact same answer every time, instead of drifting run to run.
model ResponseCache {
  id         String    @id @default(cuid())
  cacheKey   String    @unique @map("cache_key")   // hash(model + system + normalized query)
  model      String
  query      String    @db.Text
  response   String    @db.Text
  hitCount   Int       @default(0) @map("hit_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastHitAt  DateTime? @map("last_hit_at")

  @@map("response_cache")
}

// ── Versioned Reasoning Logs (LLM Limitation #5 fix) ──────────────────────────
// One row per response — what mode it ran in, what was retrieved, what tools
// fired, and whether it came from cache — so a "why did this answer change"
// question can be diagnosed instead of just observed.
model ReasoningLog {
  id              String   @id @default(cuid())
  requestId       String   @map("request_id")
  logVersion      Int      @default(1) @map("log_version")   // schema version of this log entry itself
  mode            String                                       // "deterministic" | "creative"
  temperature     Float
  wasCached       Boolean  @default(false) @map("was_cached")
  memoryFactsUsed Int      @default(0) @map("memory_facts_used")
  memorySuggestionsUsed Int @default(0) @map("memory_suggestions_used")
  toolsCalled     Json     @default("[]") @map("tools_called")
  groundingFlagged Boolean @default(false) @map("grounding_flagged")
  confidence      Float?
  ownerKey        String?  @map("owner_key")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@index([ownerKey])
  @@map("reasoning_logs")
}

// ── Observability: Langfuse-compatible traces ─────────────────────────────────
model Trace {
  id        String   @id @default(cuid())
  name      String
  input     Json
  output    Json?
  model     String?
  latencyMs Int?     @map("latency_ms")
  tokens    Int      @default(0)
  cost      Float    @default(0)
  score     Float?
  tags      Json     @default("[]")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("traces")
}

// ── MCP: Model Context Protocol server registry ───────────────────────────────
model McpServer {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("sse")    // sse | http | stdio
  tools     Json     @default("[]")
  status    String   @default("inactive")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mcp_servers")
}

// ── Scripts: Python / Shell script library ───────────────────────────────────
model Script {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  language    String   @default("python")
  code        String   @db.Text
  tags        Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("scripts")
}

// ── Auth: Users & Sessions ────────────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("intern")   // admin | engineer | intern
  status      String    @default("active")   // active | suspended
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model ApiEndpoint {
  id             String       @id @default(cuid())
  name           String
  method         String       @default("POST")
  path           String
  description    String?      @db.Text
  requestSchema  Json         @default("{}") @map("request_schema")
  responseSchema Json         @default("{}") @map("response_schema")
  headers        Json         @default("{}")
  auth           String       @default("api_key")
  status         String       @default("draft")
  version        String       @default("v1")
  requests       ApiRequest[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("api_endpoints")
}

// ── API Dev: API keys ─────────────────────────────────────────────────────────
model ApiKey {
  id           String    @id @default(cuid())
  name         String
  key          String    @unique
  prefix       String
  permissions  Json      @default("[]")
  status       String    @default("active")
  requestCount Int       @default(0) @map("request_count")
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

// ── API Dev: Pipeline definitions ─────────────────────────────────────────────
model ApiPipeline {
  id           String           @id @default(cuid())
  name         String
  description  String?          @db.Text
  steps        Json             @default("[]")
  inputSchema  Json             @default("{}") @map("input_schema")
  outputSchema Json             @default("{}") @map("output_schema")
  status       String           @default("draft")
  runs         ApiPipelineRun[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("api_pipelines")
}

model ApiPipelineRun {
  id         String      @id @default(cuid())
  pipelineId String      @map("pipeline_id")
  pipeline   ApiPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  input      Json
  output     Json?
  steps      Json        @default("[]")
  status     String      @default("pending")
  latencyMs  Int?        @map("latency_ms")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("api_pipeline_runs")
}

// ── API Dev: Request history (tester + live traffic) ─────────────────────────
model ApiRequest {
  id          String       @id @default(cuid())
  endpointId  String?      @map("endpoint_id")
  endpoint    ApiEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  method      String
  path        String
  headers     Json         @default("{}")
  body        Json?
  response    Json?
  statusCode  Int?         @map("status_code")
  latencyMs   Int?         @map("latency_ms")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("api_requests")
}

// ── Billing: Customers & Subscriptions ───────────────────────────────────────
model Customer {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  stripeCustomerId    String?         @unique @map("stripe_customer_id")
  plan                String          @default("free")
  creditBalance       Float           @default(0) @map("credit_balance")
  autoReload          Boolean         @default(false) @map("auto_reload")
  autoReloadAmount    Float           @default(50) @map("auto_reload_amount")
  autoReloadThreshold Float           @default(5) @map("auto_reload_threshold")
  memoryEnabled       Boolean         @default(true) @map("memory_enabled")  // consent layer — off = no memory writes
  createdAt           DateTime        @default(now()) @map("created_at")
  subscriptions       Subscription[]
  creditPurchases     CreditPurchase[]
  @@map("customers")
}

model Subscription {
  id               String    @id @default(cuid())
  customerId       String    @map("customer_id")
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan             String
  billingPeriod    String    @default("monthly") @map("billing_period")
  status           String    @default("active")
  stripeSubId      String?   @unique @map("stripe_sub_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean  @default(false) @map("cancel_at_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  @@map("subscriptions")
}

model CreditPurchase {
  id              String   @id @default(cuid())
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Float
  discountRate    Float    @default(0) @map("discount_rate")
  creditsAdded    Float    @map("credits_added")
  autoReload      Boolean  @default(false) @map("auto_reload")
  stripePaymentId String?  @map("stripe_payment_id")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  @@map("credit_purchases")
}

// ── Activity Log — tracks every meaningful action per user ───────────────────
// ─────────────────────────────────────────────────────────────────────────────
// BEHAVIORAL REGRESSION & DRIFT DETECTION  —  Phase 3
// Treats model behavior like code: a golden set of validated examples is
// re-run on every prompt/model/RAG change, semantically diffed by a judge
// model (not string-matched), and scored for regression severity. A run
// below threshold blocks deployment the way a failing test blocks a merge.
// ─────────────────────────────────────────────────────────────────────────────

// ── Golden Set — validated input/output pairs used as the regression baseline
model GoldenExample {
  id             String   @id @default(cuid())
  domain         String
  input          String   @db.Text
  systemPrompt   String   @map("system_prompt") @db.Text
  expectedOutput String   @map("expected_output") @db.Text
  difficulty     String   @default("standard")        // "easy" | "standard" | "hard" | "edge_case"
  tags           Json     @default("[]")
  sourceRecordId String?  @map("source_record_id")    // if promoted from an approved training Record
  active         Boolean  @default(true)               // inactive examples are excluded from runs without deleting history
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  results        RegressionResult[]
  @@index([domain])
  @@map("golden_examples")
}

// ── Regression Run — one full pass of the golden set against current state
model RegressionRun {
  id              String   @id @default(cuid())
  triggerType     String   @map("trigger_type")        // "manual" | "prompt_change" | "model_deploy" | "rag_update" | "scheduled"
  triggerDetail   String?  @map("trigger_detail") @db.Text
  model           String                                 // model tested, e.g. nexgen-flash-v1
  totalExamples   Int      @default(0) @map("total_examples")
  passed          Int      @default(0)
  failed          Int      @default(0)
  warnings        Int      @default(0)
  avgScore        Float?   @map("avg_score")
  severity        String   @default("none")             // "none" | "minor" | "moderate" | "severe"
  gateStatus      String   @default("pending")           // "pending" | "passed" | "blocked" | "overridden"
  overriddenById  String?  @map("overridden_by_id")
  overrideReason  String?  @map("override_reason") @db.Text
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  triggeredById   String?  @map("triggered_by_id")

  results         RegressionResult[]
  @@index([startedAt])
  @@map("regression_runs")
}

// ── Regression Result — one golden example's outcome within a specific run
model RegressionResult {
  id               String   @id @default(cuid())
  runId            String   @map("run_id")
  run              RegressionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  goldenExampleId  String   @map("golden_example_id")
  goldenExample    GoldenExample  @relation(fields: [goldenExampleId], references: [id], onDelete: Cascade)
  actualOutput     String   @db.Text
  score            Float                                  // 0-100 composite semantic similarity score
  verdict          String                                  // "pass" | "fail" | "warning"
  factualConsistency Float? @map("factual_consistency")     // 0-100, did claims stay accurate vs golden
  completeness       Float?                                 // 0-100, was anything material dropped
  toneDrift          Float? @map("tone_drift")              // 0-100, 100 = no drift
  addedClaims        Json   @default("[]") @map("added_claims")     // claims present in new output but not golden
  droppedClaims       Json   @default("[]") @map("dropped_claims")   // claims present in golden but missing from new output
  rootCause          String? @map("root_cause")             // judge's best guess: "model" | "prompt" | "rag_corpus" | "unclear"
  judgeNotes          String? @map("judge_notes") @db.Text
  // ── Hallucination detection — independent of golden-answer comparison ──────
  hallucinationRate    Float?  @map("hallucination_rate")     // 0-100, % of claims that could NOT be corroborated
  unverifiedClaims     Json    @default("[]") @map("unverified_claims")  // specific claims flagged as unverified/fabricated
  // ── Bias drift — scored independently of correctness ───────────────────────
  biasScore            Float?  @map("bias_score")             // 0-100, 100 = no detected bias
  biasFlags            Json    @default("[]") @map("bias_flags")         // e.g. ["gender_stereotype", "political_lean"]
  latencyMs           Int?   @map("latency_ms")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@index([goldenExampleId])
  @@map("regression_results")
}

// ── Model Comparison — side-by-side A/B eval of two model versions ──────────
model ModelComparisonRun {
  id            String   @id @default(cuid())
  modelA        String   @map("model_a")
  modelB        String   @map("model_b")
  totalExamples Int      @default(0) @map("total_examples")
  aWins         Int      @default(0) @map("a_wins")
  bWins         Int      @default(0) @map("b_wins")
  ties          Int      @default(0)
  avgScoreA     Float?   @map("avg_score_a")
  avgScoreB     Float?   @map("avg_score_b")
  avgHallucinationA Float? @map("avg_hallucination_a")
  avgHallucinationB Float? @map("avg_hallucination_b")
  avgBiasA          Float? @map("avg_bias_a")
  avgBiasB          Float? @map("avg_bias_b")
  recommendation    String?  @db.Text                    // judge's overall recommendation: promote B, keep A, inconclusive
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  triggeredById String?  @map("triggered_by_id")

  results       ModelComparisonResult[]
  @@map("model_comparison_runs")
}

model ModelComparisonResult {
  id              String   @id @default(cuid())
  comparisonId    String   @map("comparison_id")
  comparison      ModelComparisonRun @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  goldenExampleId String   @map("golden_example_id")
  outputA         String   @db.Text
  outputB         String   @db.Text
  scoreA          Float    @map("score_a")
  scoreB          Float    @map("score_b")
  hallucinationA  Float?   @map("hallucination_a")
  hallucinationB  Float?   @map("hallucination_b")
  biasA           Float?   @map("bias_a")
  biasB           Float?   @map("bias_b")
  winner          String                                   // "a" | "b" | "tie"
  judgeNotes      String?  @map("judge_notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([comparisonId])
  @@map("model_comparison_results")
}

// ── Code Execution — sandboxed Python, callable by NexGen mid-response ───────
// Every execution is logged for audit regardless of whether it was triggered
// automatically by the model (tool_call) or manually tested in the lab.
// ── Generated Documents — real Word/Markdown/PPTX/infographic output ─────────
// Every document NexGen generates is logged and served from a static path so
// it can be downloaded, not just described.
model GeneratedDocument {
  id            String   @id @default(cuid())
  format        String                                 // "word" | "markdown" | "powerpoint" | "infographic"
  title         String
  storageKey    String   @map("storage_key")             // S3 key, or local filename — never exposed directly to clients
  persistent    Boolean  @default(false)                 // true = durable object storage, false = ephemeral local disk
  fileSizeKb    Float?   @map("file_size_kb")
  downloadToken String   @unique @map("download_token")  // random, unguessable — this IS the auth for the download link
  tokenExpiresAt DateTime @map("token_expires_at")        // links expire — nothing is permanently public
  downloadCount Int      @default(0) @map("download_count")
  ownerKey      String?  @map("owner_key")
  triggeredBy   String   @default("manual") @map("triggered_by")  // "tool_call" | "manual"
  domain        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ownerKey])
  @@index([createdAt])
  @@index([downloadToken])
  @@map("generated_documents")
}

model CodeExecution {
  id          String   @id @default(cuid())
  language    String   @default("python")               // python | node | typescript | swift | kotlin
  code        String   @db.Text
  stdout      String?  @db.Text
  stderr      String?  @db.Text
  exitCode    Int?     @map("exit_code")
  timedOut    Boolean  @default(false) @map("timed_out")
  durationMs  Int?     @map("duration_ms")
  ownerKey    String?  @map("owner_key")           // the nxg-... key that triggered it, if via chat
  triggeredBy String   @default("manual") @map("triggered_by")  // "tool_call" | "manual"
  domain      String?                                // domain context, e.g. predictive_maintenance
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerKey])
  @@index([createdAt])
  @@map("code_executions")
}

// ── Task Assignment — admins assign each team member a task from the side ────
// menu, with optional domain scoping for Data Collection and Processing.
// ── Bulk Generation — turns a list of questions into real user+assistant
// records automatically, without one-at-a-time manual generation. Runs as a
// background job (many questions can take minutes) with pollable progress.
// ── Golden Set Auto-Select — automatically curates PROOF's golden set from
// approved records, per domain, using a judge pass to pick diverse,
// high-quality examples rather than naive random sampling. Runs as a
// background job since it may sweep every domain with approved data.
model GoldenSetAutoSelectJob {
  id              String   @id @default(cuid())
  domainsRequested Json    @default("[]") @map("domains_requested")   // [] means "all domains with approved data"
  perDomainCount  Int      @default(15) @map("per_domain_count")
  status          String   @default("running")   // "running" | "completed" | "failed"
  results         Json     @default("[]")           // [{ domain, candidates_considered, selected_count, golden_ids }]
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@map("golden_set_auto_select_jobs")
}

// ── Auto-Process — sweeps a domain's needs_review records, running the exact
// same Validate → Fix → Approve/Reject flow a human reviewer would use
// manually, one record at a time. A record is only auto-approved if the AI's
// own judgment supports it — a low-confidence result after a fix attempt is
// left in needs_review for a human, never force-approved.
// ── Deduplication — finds near-duplicate records within a domain (by question
// text similarity) and removes all but the oldest of each group. Runs as a
// background job; every removal is logged with which record it duplicated,
// so the decision is always auditable, never a silent deletion.
model DeduplicationJob {
  id             String   @id @default(cuid())
  domain         String
  totalRecords   Int      @default(0) @map("total_records")
  groupsFound    Int      @default(0) @map("groups_found")
  duplicatesRemoved Int   @default(0) @map("duplicates_removed")
  status         String   @default("running")   // "running" | "completed" | "failed"
  results        Json     @default("[]")           // [{ kept_id, kept_question, removed: [{id, question, similarity}] }]
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("deduplication_jobs")
}

model AutoProcessJob {
  id            String   @id @default(cuid())
  domain        String
  totalRecords  Int      @default(0) @map("total_records")
  approvedCount Int      @default(0) @map("approved_count")
  fixedCount    Int      @default(0) @map("fixed_count")           // subset of approvedCount that needed a fix first
  rejectedCount Int      @default(0) @map("rejected_count")
  leftForReviewCount Int @default(0) @map("left_for_review_count")  // AI wasn't confident even after a fix attempt
  status        String   @default("running")   // "running" | "completed" | "failed"
  results       Json     @default("[]")           // [{ record_id, outcome, score, reason }]
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  @@map("auto_process_jobs")
}

model BulkGenerationJob {
  id             String   @id @default(cuid())
  domain         String
  totalQuestions Int      @map("total_questions")
  completedCount Int      @default(0) @map("completed_count")
  failedCount    Int      @default(0) @map("failed_count")
  status         String   @default("running")   // "running" | "completed" | "failed"
  results        Json     @default("[]")          // [{ question, status: "created"|"failed", record_id?, error? }]
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("bulk_generation_jobs")
}

model TaskAssignment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")             // the team member this task is assigned to
  module        String                                 // matches a sidebar module id, e.g. "collect", "process", "pipelines"
  domains       Json     @default("[]")                 // array of domain ids, only meaningful for "collect" / "process"
  notes         String?  @db.Text
  assignedById  String?  @map("assigned_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attachments   AssignmentAttachment[]

  @@index([userId])
  @@map("task_assignments")
}

// ── Files an admin attaches to a specific assignment — instructions, specs,
// reference material. Access is scoped: the assigned team member can only
// ever see/download attachments on THEIR OWN assignment, enforced both at
// the listing endpoint and via the same signed, expiring download-token
// pattern already used for generated documents. ──────────────────────────────
model AssignmentAttachment {
  id             String   @id @default(cuid())
  assignmentId   String   @map("assignment_id")
  assignment     TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  filename       String                                   // original filename, e.g. "PPAP-checklist.pdf"
  storageKey     String   @map("storage_key")             // S3 key or local filename — reuses the document storage layer
  persistent     Boolean  @default(false)
  fileSizeKb     Float?   @map("file_size_kb")
  mimeType       String?  @map("mime_type")
  downloadToken  String   @unique @map("download_token")
  tokenExpiresAt DateTime @map("token_expires_at")
  uploadedById   String?  @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([assignmentId])
  @@index([downloadToken])
  @@map("assignment_attachments")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")
  action    String              // e.g. "record.created", "record.approved", "pipeline.run", "key.created"
  resource  String?             // e.g. record id, pipeline id
  details   Json?               // extra context (domain, model used, etc.)
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
